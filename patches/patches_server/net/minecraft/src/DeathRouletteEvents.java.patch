+	// =====================================================================
+	// Server-Side Timed Execution Helpers
+	// =====================================================================
+
+	private static class ServerTimedEvent {
+		final String username;
+		final int eventId;
+		int remainingTicks;
+		boolean inTick;
+
+		ServerTimedEvent(String username, int eventId, int remainingTicks) {
+			this.username = username;
+			this.eventId = eventId;
+			this.remainingTicks = remainingTicks;
+			this.inTick = false;
+		}
+	}
+
+	private static class ServerTimedRunnable {
+		int remainingTicks;
+		final Runnable task;
+
+		ServerTimedRunnable(int remainingTicks, Runnable task) {
+			this.remainingTicks = remainingTicks;
+			this.task = task;
+		}
+	}
+
+	private static final List activeServerTimers = new ArrayList();
+	private static final List activeServerRunnables = new ArrayList();
+
+	public static synchronized void startTimerSeconds(EntityPlayerMP player, int eventId, double seconds) {
+		startTimerTicks(player, eventId, (int)Math.round(seconds * 20.0D));
+	}
+
+	public static synchronized void startTimerTicks(EntityPlayerMP player, int eventId, int ticks) {
+		if(player == null || ticks <= 0) {
+			return;
+		}
+		for(int i = 0; i < activeServerTimers.size(); ++i) {
+			ServerTimedEvent ste = (ServerTimedEvent)activeServerTimers.get(i);
+			if(ste.eventId == eventId && ste.username.equals(player.username)) {
+				if(ste.inTick) {
+					return;
+				}
+				ste.remainingTicks = ticks;
+				return;
+			}
+		}
+		activeServerTimers.add(new ServerTimedEvent(player.username, eventId, ticks));
+	}
+
+	public static synchronized void stopTimer(EntityPlayerMP player, int eventId) {
+		if(player == null) {
+			return;
+		}
+		Iterator it = activeServerTimers.iterator();
+		while(it.hasNext()) {
+			ServerTimedEvent ste = (ServerTimedEvent)it.next();
+			if(ste.eventId == eventId && ste.username.equals(player.username)) {
+				it.remove();
+			}
+		}
+	}
+
+	public static synchronized void runForSeconds(double seconds, Runnable task) {
+		runForTicks((int)Math.round(seconds * 20.0D), task);
+	}
+
+	public static synchronized void runForTicks(int ticks, Runnable task) {
+		if(ticks > 0 && task != null) {
+			activeServerRunnables.add(new ServerTimedRunnable(ticks, task));
+		}
+	}
+
+	public static synchronized void onServerTick(MinecraftServer server) {
+		if(server == null || server.getConfigurationManager() == null) {
+			return;
+		}
+		if(DeathRouletteServerManager.isTickFrozen()) {
+			return;
+		}
+
+		Iterator it = activeServerTimers.iterator();
+		while(it.hasNext()) {
+			ServerTimedEvent ste = (ServerTimedEvent)it.next();
+			EntityPlayerMP player = server.getConfigurationManager().getPlayerForUsername(ste.username);
+			if(player != null && ste.remainingTicks > 0) {
+				--ste.remainingTicks;
+				ste.inTick = true;
+				try {
+					executeServerEvent(server, player, ste.eventId);
+				} finally {
+					ste.inTick = false;
+				}
+			}
+			if(ste.remainingTicks <= 0) {
+				it.remove();
+			}
+		}
+
+		Iterator rit = activeServerRunnables.iterator();
+		while(rit.hasNext()) {
+			ServerTimedRunnable str = (ServerTimedRunnable)rit.next();
+			if(str.remainingTicks > 0) {
+				--str.remainingTicks;
+				str.task.run();
+			}
+			if(str.remainingTicks <= 0) {
+				rit.remove();
+			}
+		}
+	}
