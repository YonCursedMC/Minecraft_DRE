+	public static int selectWeightedEvent(double[] weights, Random rand) {
+		int limit = Math.min(EVENT_COUNT, weights.length);
+		double total = 0.0D;
+		for(int i = 0; i < limit; ++i) {
+			if(weights[i] > 0.0D) {
+				total += weights[i];
+			}
+		}
+
+		if(total <= 0.0D) {
+			return rand.nextInt(limit);
+		}
+
+		double r = rand.nextDouble() * total;
+		double cumulative = 0.0D;
+		for(int i = 0; i < limit; ++i) {
+			if(weights[i] > 0.0D) {
+				cumulative += weights[i];
+				if(r <= cumulative) {
+					return i;
+				}
+			}
+		}
+
+		return limit - 1;
+	}
