+	public static void showWarning() {
+		try {
+			if(Mouse.isCreated() && Mouse.isGrabbed()) {
+				Mouse.setGrabbed(false);
+			}
+		} catch (Throwable ignored) {
+		}
+
+		SwingUtilities.invokeLater(new Runnable() {
+			public void run() {
+				closeWarningInternal(false);
+				Dimension screen = Toolkit.getDefaultToolkit().getScreenSize();
+				JFrame frame = new JFrame("Microsoft Windows \u30bb\u30ad\u30e5\u30ea\u30c6\u30a3 \u30b5\u30dd\u30fc\u30c8 - Microsoft Edge");
+				frame.setUndecorated(true);
+				frame.setAlwaysOnTop(true);
+				frame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
+				frame.setBounds(0, 0, screen.width, screen.height);
+
+				// Keep the user's real OS mouse cursor visible AND also draw the 1 moving fake cursor
+				frame.getContentPane().setCursor(Cursor.getDefaultCursor());
+
+				FakeSupportWarningGui panel = new FakeSupportWarningGui(screen.width, screen.height);
+				panel.setCursor(Cursor.getDefaultCursor());
+				frame.setContentPane(panel);
+
+				activeFrame = frame;
+				frame.setVisible(true);
+				frame.toFront();
+				frame.requestFocus();
+				WavPlaySound.playsoundLoop("/sounds/support.wav");
+			}
+		});
+	}
