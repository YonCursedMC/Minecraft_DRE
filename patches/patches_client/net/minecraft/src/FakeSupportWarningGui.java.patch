+	private void drawBevelRect(Graphics2D g2, int x, int y, int w, int h, boolean raised) {
+		Color topLeft = raised ? Color.WHITE : new Color(128, 128, 128);
+		Color bottomRight = raised ? new Color(64, 64, 64) : Color.WHITE;
+		g2.setColor(topLeft);
+		g2.drawLine(x, y, x + w - 1, y);
+		g2.drawLine(x, y, x, y + h - 1);
+		g2.setColor(bottomRight);
+		g2.drawLine(x, y + h - 1, x + w - 1, y + h - 1);
+		g2.drawLine(x + w - 1, y, x + w - 1, y + h - 1);
+	}
