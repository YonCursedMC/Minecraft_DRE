+	private void drawXpClassicCommandPrompt(Graphics2D g2, int x, int y, int w, int h) {
+		// Drop shadow
+		g2.setColor(new Color(0, 0, 0, 125));
+		g2.fillRect(x + 8, y + 8, w, h);
+
+		// Classic Windows XP / 2000 3D gray outer frame (#D4D0C8)
+		Color classicGray = new Color(212, 208, 200);
+		g2.setColor(classicGray);
+		g2.fillRect(x, y, w, h);
+
+		// Outer 3D raised bevel
+		drawBevelRect(g2, x, y, w, h, true);
+		drawBevelRect(g2, x + 1, y + 1, w - 2, h - 2, true);
+
+		// Classic gradient title bar (#0A246A -> #A6CAF0)
+		int tbX = x + 4;
+		int tbY = y + 4;
+		int tbW = w - 8;
+		int tbH = 22;
+		GradientPaint tbGrad = new GradientPaint(
+				tbX, tbY, new Color(10, 36, 106),
+				tbX + tbW, tbY, new Color(166, 202, 240));
+		g2.setPaint(tbGrad);
+		g2.fillRect(tbX, tbY, tbW, tbH);
+
+		// Mini C:\_ icon in title bar
+		g2.setColor(Color.BLACK);
+		g2.fillRect(tbX + 4, tbY + 4, 15, 13);
+		g2.setColor(Color.WHITE);
+		g2.drawRect(tbX + 4, tbY + 4, 15, 13);
+		g2.setFont(new Font("Monospaced", Font.BOLD, 8));
+		g2.drawString("C:\\", tbX + 5, tbY + 13);
+
+		// Title text
+		g2.setColor(Color.WHITE);
+		g2.setFont(new Font("SansSerif", Font.BOLD, 12));
+		g2.drawString("C:\\WINDOWS\\system32\\cmd.exe", tbX + 24, tbY + 16);
+
+		// Classic 3D caption buttons ([_], [\u25a1], [X])
+		String[] capLabels = new String[] { "_", "\u25a1", "X" };
+		for(int i = 0; i < 3; ++i) {
+			int bx = tbX + tbW - 56 + i * 18 + (i == 2 ? 2 : 0);
+			int by = tbY + 3;
+			int bw = 16;
+			int bh = 15;
+			g2.setColor(classicGray);
+			g2.fillRect(bx, by, bw, bh);
+			drawBevelRect(g2, bx, by, bw, bh, true);
+			g2.setColor(Color.BLACK);
+			g2.setFont(new Font("SansSerif", Font.BOLD, 10));
+			g2.drawString(capLabels[i], bx + 4, by + 11);
+		}
+
+		// Sunken client area border
+		int clientX = x + 4;
+		int clientY = y + 28;
+		int clientW = w - 8;
+		int clientH = h - 32;
+		drawBevelRect(g2, clientX, clientY, clientW, clientH, false);
+		drawBevelRect(g2, clientX + 1, clientY + 1, clientW - 2, clientH - 2, false);
+
+		// Black console area
+		int termX = clientX + 2;
+		int termY = clientY + 2;
+		int scrollW = 16;
+		int termW = clientW - 4 - scrollW;
+		int termH = clientH - 4;
+		g2.setColor(Color.BLACK);
+		g2.fillRect(termX, termY, termW, termH);
+
+		// Classic vertical scrollbar on the right of the console
+		int sbX = termX + termW;
+		g2.setColor(new Color(230, 228, 222));
+		g2.fillRect(sbX, termY, scrollW, termH);
+		// Top arrow button
+		g2.setColor(classicGray);
+		g2.fillRect(sbX, termY, scrollW, 16);
+		drawBevelRect(g2, sbX, termY, scrollW, 16, true);
+		// Bottom arrow button
+		g2.fillRect(sbX, termY + termH - 16, scrollW, 16);
+		drawBevelRect(g2, sbX, termY + termH - 16, scrollW, 16, true);
+		// Scrollbar thumb (rapidly bobbing near bottom as lines stream)
+		int thumbH = 42;
+		int thumbJitter = (this.tick % 4) * 3;
+		int thumbY = termY + termH - 16 - thumbH - thumbJitter;
+		g2.fillRect(sbX, thumbY, scrollW, thumbH);
+		drawBevelRect(g2, sbX, thumbY, scrollW, thumbH, true);
+		g2.setColor(Color.BLACK);
+		g2.setFont(new Font("SansSerif", Font.PLAIN, 9));
+		g2.drawString("\u25b2", sbX + 4, termY + 12);
+		g2.drawString("\u25bc", sbX + 4, termY + termH - 4);
+
+		// Fast-scrolling console text lines (clipped to black terminal area)
+		java.awt.Shape oldClip = g2.getClip();
+		g2.setClip(termX, termY, termW, termH);
+		g2.setFont(new Font("Monospaced", Font.PLAIN, 12));
+
+		int visibleLines = (termH - 10) / 14;
+		// Advance 2 lines per frame (~120 lines/sec) so commands stream rapidly!
+		int streamHead = this.tick * 2;
+		int lineY = termY + 15;
+		for(int i = 0; i < visibleLines; ++i) {
+			int poolIdx = (streamHead + i) % CMD_STREAM_POOL.length;
+			String line = CMD_STREAM_POOL[poolIdx];
+			if(i == visibleLines - 1 && (this.tick % 6) < 3) {
+				line = line + "_";
+			}
+			if(line.indexOf("CRITICAL") >= 0 || line.indexOf("HOOK") >= 0 || line.indexOf("REMOTE") >= 0 || line.indexOf("TROJAN") >= 0 || line.indexOf("ENCRYPT") >= 0) {
+				g2.setColor(new Color(255, 105, 105));
+			} else if(line.startsWith("C:\\WINDOWS\\system32>")) {
+				g2.setColor(new Color(240, 240, 240));
+			} else {
+				g2.setColor(new Color(192, 192, 192));
+			}
+			g2.drawString(line, termX + 6, lineY);
+			lineY += 14;
+		}
+		g2.setClip(oldClip);
+	}
