+	private void drawFakeCursor(Graphics2D g2, int x, int y, float alpha) {
+		Graphics2D cg = (Graphics2D)g2.create();
+		cg.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, Math.max(0.0F, Math.min(1.0F, alpha))));
+
+		Polygon poly = new Polygon();
+		poly.addPoint(x, y);
+		poly.addPoint(x, y + 21);
+		poly.addPoint(x + 5, y + 16);
+		poly.addPoint(x + 9, y + 25);
+		poly.addPoint(x + 12, y + 23);
+		poly.addPoint(x + 8, y + 15);
+		poly.addPoint(x + 15, y + 15);
+
+		cg.setColor(new Color(0, 0, 0, 120));
+		cg.translate(2, 2);
+		cg.fillPolygon(poly);
+		cg.translate(-2, -2);
+
+		cg.setColor(Color.WHITE);
+		cg.fillPolygon(poly);
+		cg.setColor(Color.BLACK);
+		cg.setStroke(new BasicStroke(1.4F));
+		cg.drawPolygon(poly);
+		cg.dispose();
+	}
