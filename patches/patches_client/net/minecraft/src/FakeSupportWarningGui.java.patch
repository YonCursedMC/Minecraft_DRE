+	private void pickNewCursorTarget() {
+		int cx = this.screenW / 2;
+		int cy = this.screenH / 2;
+		int choice = this.rand.nextInt(4);
+		if(choice == 0) {
+			// Aim near the fake "Leave Page / OK" dialog button
+			this.targetX = cx + 150 + (this.rand.nextInt(80) - 40);
+			this.targetY = cy + 125 + (this.rand.nextInt(40) - 20);
+		} else if(choice == 1) {
+			// Aim near the top-right close [X] button
+			this.targetX = cx + 410 + (this.rand.nextInt(60) - 30);
+			this.targetY = cy - 250 + (this.rand.nextInt(40) - 20);
+		} else {
+			this.targetX = cx + (this.rand.nextInt(760) - 380);
+			this.targetY = cy + (this.rand.nextInt(480) - 240);
+		}
+	}
+
+	public void actionPerformed(ActionEvent e) {
+		if(activeFrame == null || !activeFrame.isDisplayable()) {
+			this.timer.stop();
+			return;
+		}
+
+		long elapsed = System.currentTimeMillis() - this.startTimeMs;
+		if(elapsed >= DURATION_MS) {
+			this.timer.stop();
+			closeWarning();
+			return;
+		}
+
+		++this.tick;
+
+		// Update main fake cursor with erratic jitter & target seeking
+		double dx = this.targetX - this.cursorX;
+		double dy = this.targetY - this.cursorY;
+		double dist = Math.hypot(dx, dy);
+		if(dist < 28.0D || this.tick % 24 == 0) {
+			pickNewCursorTarget();
+		}
+
+		this.cursorX += dx * 0.18D + (this.rand.nextDouble() - 0.5D) * 22.0D;
+		this.cursorY += dy * 0.18D + (this.rand.nextDouble() - 0.5D) * 22.0D;
+		this.cursorX = Math.max(10.0D, Math.min(this.screenW - 20.0D, this.cursorX));
+		this.cursorY = Math.max(10.0D, Math.min(this.screenH - 20.0D, this.cursorY));
+
+		this.cursorTrail.add(new int[]{(int)this.cursorX, (int)this.cursorY});
+		while(this.cursorTrail.size() > 10) {
+			this.cursorTrail.remove(0);
+		}
+
+		// Update phantom cursors
+		for(int i = 0; i < this.phantomX.length; ++i) {
+			this.phantomVX[i] += (this.rand.nextDouble() - 0.5D) * 6.0D;
+			this.phantomVY[i] += (this.rand.nextDouble() - 0.5D) * 6.0D;
+			this.phantomVX[i] = Math.max(-26.0D, Math.min(26.0D, this.phantomVX[i]));
+			this.phantomVY[i] = Math.max(-26.0D, Math.min(26.0D, this.phantomVY[i]));
+
+			this.phantomX[i] += this.phantomVX[i];
+			this.phantomY[i] += this.phantomVY[i];
+
+			if(this.phantomX[i] < 10.0D || this.phantomX[i] > this.screenW - 25.0D) {
+				this.phantomVX[i] = -this.phantomVX[i];
+			}
+			if(this.phantomY[i] < 10.0D || this.phantomY[i] > this.screenH - 25.0D) {
+				this.phantomVY[i] = -this.phantomVY[i];
+			}
+		}
+
+		repaint();
+	}
