+			}
+			activeFrame = null;
+		}
+		if(restoreMouseGrab) {
+			try {
+				Minecraft mc = Minecraft.getMinecraft();
+				if(mc != null && mc.currentScreen == null && Display.isActive()) {
+					mc.inGameHasFocus = true;
+					mc.mouseHelper.grabMouseCursor();
+				}
+			} catch (Throwable ignored) {
+			}
+		}
+	}
