+		this.timer = new Timer(16, this);
+		this.timer.start();
+	}
+
+	private void pickNewCursorTarget() {
+		int cx = this.screenW / 2;
+		int cy = this.screenH / 2;
+		int choice = this.rand.nextInt(4);
+		if(choice == 0) {
+			// Aim near the modal dialog OK / Cancel buttons
+			this.targetX = cx + 110 + (this.rand.nextInt(100) - 50);
+			this.targetY = cy + 135 + (this.rand.nextInt(30) - 15);
+		} else if(choice == 1) {
+			// Aim near the floating scaling window button
+			this.targetX = Math.min(this.screenW - 220, cx + 360) + (this.rand.nextInt(120) - 60);
+			this.targetY = cy + 65 + (this.rand.nextInt(40) - 20);
+		} else if(choice == 2) {
+			// Aim near the XP Command Prompt window
+			this.targetX = Math.max(120, cx - 350) + (this.rand.nextInt(160) - 80);
+			this.targetY = Math.max(180, cy - 120) + (this.rand.nextInt(100) - 50);
+		} else {
+			this.targetX = cx + (this.rand.nextInt(800) - 400);
+			this.targetY = cy + (this.rand.nextInt(500) - 250);
+		}
+	}
+
+	public void actionPerformed(ActionEvent e) {
+		if(activeFrame == null || !activeFrame.isDisplayable()) {
+			this.timer.stop();
+			return;
+		}
+
+		long elapsed = System.currentTimeMillis() - this.startTimeMs;
+		if(elapsed >= DURATION_MS) {
+			this.timer.stop();
+			closeWarning();
+			return;
+		}
+
+		++this.tick;
+
+		// Smoothly move the single fake cursor toward target (no shaking or trail effects)
+		double dx = this.targetX - this.cursorX;
+		double dy = this.targetY - this.cursorY;
+		double dist = Math.hypot(dx, dy);
+		if(dist < 16.0D || this.tick % 45 == 0) {
+			pickNewCursorTarget();
+		} else {
+			double speed = Math.min(dist, Math.max(4.5D, dist * 0.09D));
+			this.cursorX += (dx / dist) * speed;
+			this.cursorY += (dy / dist) * speed;
+		}
+		this.cursorX = Math.max(10.0D, Math.min(this.screenW - 20.0D, this.cursorX));
+		this.cursorY = Math.max(10.0D, Math.min(this.screenH - 20.0D, this.cursorY));
+
+		repaint();
+	}
