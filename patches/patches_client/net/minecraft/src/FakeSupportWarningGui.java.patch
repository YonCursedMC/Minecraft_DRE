+		this.startTimeMs = System.currentTimeMillis();
+
+		this.cursorX = w * 0.5D;
+		this.cursorY = h * 0.5D;
+		pickNewCursorTarget();
+
+		for(int i = 0; i < this.phantomX.length; ++i) {
+			this.phantomX[i] = this.rand.nextInt(Math.max(1, w));
+			this.phantomY[i] = this.rand.nextInt(Math.max(1, h));
+			this.phantomVX[i] = (this.rand.nextDouble() - 0.5D) * 28.0D;
+			this.phantomVY[i] = (this.rand.nextDouble() - 0.5D) * 28.0D;
+		}
+
+		this.timer = new Timer(16, this);
+		this.timer.start();
+	}
