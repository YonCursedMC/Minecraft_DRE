+	/**
+	 * Sends a packet from the server to start a client-side tick timer for the specified eventId.
+	 * On the client, tickEventX(mc) will be called every tick for the given number of seconds.
+	 */
+	public static void startTimerSeconds(EntityPlayerMP player, int eventId, double seconds) {
+		int ticks = (int)Math.round(seconds * 20.0D);
+		startTimerTicks(player, eventId, ticks);
+	}
