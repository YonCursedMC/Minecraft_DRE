+/**
+ * Helper class for sending a Packet250CustomPayload from the server to a specific player (or all players)
+ * and executing the corresponding method ONLY on the receiving client.
+ * Also supports timed execution (running every tick for N seconds/ticks, or on a background thread).
+ *
+ * Usage on Server / DeathRouletteEvents:
+ *   ClientEvents.event14(player);                      // Runs ClientEvents.event14(mc) once on client
+ *   ClientEvents.startTimerSeconds(player, 16, 10);    // Runs ClientEvents.tickEvent16(mc) every tick for 10s on client
+ *   ClientEvents.startTimerTicks(player, 16, 200);     // Runs ClientEvents.tickEvent16(mc) every tick for 200 ticks on client
+ */
+public class ClientEvents {
+	public static final String CHANNEL = "DRE|Client";
+
+	private static final byte MODE_ONCE = 0;
+	private static final byte MODE_TIMER_TICKS = 1;
+	private static final byte MODE_STOP_TIMER = 2;
+
+	// Optional arguments received with the latest packet on the client
+	public static int lastIntArg = 0;
+	public static String lastStrArg = "";
+
+	// Remaining ticks for each client event timer (event0 ~ event30)
+	private static final int[] eventTimers = new int[DeathRouletteEvents.EVENT_COUNT];
+	private static final boolean[] inTimerTick = new boolean[DeathRouletteEvents.EVENT_COUNT];
+	// Elapsed ticks since timer started for each event (0, 1, 2, ...)
+	public static final int[] eventElapsedTicks = new int[DeathRouletteEvents.EVENT_COUNT];
+
+	private static class TimedTask {
+		int remainingTicks;
+		final Runnable task;
+
+		TimedTask(int remainingTicks, Runnable task) {
+			this.remainingTicks = remainingTicks;
+			this.task = task;
+		}
+	}
+
+	private static final List customTimedTasks = new ArrayList();
