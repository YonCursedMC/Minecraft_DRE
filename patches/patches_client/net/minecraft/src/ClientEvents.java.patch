+	// =====================================================================
+	// Client Packet Receiver & Tick Handler (Runs ONLY on the Client)
+	// =====================================================================
+
+	public static void handleClientPacket(Minecraft mc, Packet250CustomPayload packet) {
+		if(packet == null || packet.data == null || packet.data.length == 0) {
+			return;
+		}
+		try {
+			DataInputStream in = new DataInputStream(new ByteArrayInputStream(packet.data));
+			byte mode = in.readByte();
+			int eventId = in.readInt();
+			int intArg = in.readInt();
+			String strArg = in.readUTF();
+
+			lastIntArg = intArg;
+			lastStrArg = strArg;
+
+			if(mode == MODE_ONCE) {
+				executeOnClient(mc, eventId, intArg, strArg);
+			} else if(mode == MODE_TIMER_TICKS) {
+				startClientTimerTicks(eventId, intArg);
+			} else if(mode == MODE_STOP_TIMER) {
+				stopClientTimer(eventId);
+			}
+		} catch (IOException e) {
+			e.printStackTrace();
+		}
+	}
+
+	public static void onClientTick(Minecraft mc) {
+		if(mc == null || mc.theWorld == null || mc.thePlayer == null) {
+			return;
+		}
+		if(DeathRouletteManager.isTickFrozen()) {
+			return;
+		}
+
+		for(int i = 0; i < eventTimers.length; ++i) {
+			if(eventTimers[i] > 0) {
+				--eventTimers[i];
+				++eventElapsedTicks[i];
+				inTimerTick[i] = true;
+				try {
+					executeOnClient(mc, i, lastIntArg, lastStrArg);
+				} finally {
+					inTimerTick[i] = false;
+				}
+			}
+		}
+
+		synchronized(customTimedTasks) {
+			Iterator it = customTimedTasks.iterator();
+			while(it.hasNext()) {
+				TimedTask tt = (TimedTask)it.next();
+				if(tt.remainingTicks > 0) {
+					--tt.remainingTicks;
+					tt.task.run();
+				}
+				if(tt.remainingTicks <= 0) {
+					it.remove();
+				}
+			}
+		}
+	}
