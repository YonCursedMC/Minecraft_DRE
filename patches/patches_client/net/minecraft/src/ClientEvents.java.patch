+	/**
+	 * Starts a client-side tick timer for eventId for the given number of seconds.
+	 * Calls eventX(mc) every client tick until time expires.
+	 * Safe to call inside eventX(mc) itself (will not reset while already ticking).
+	 */
+	public static void startClientTimerSeconds(int eventId, double seconds) {
+		startClientTimerTicks(eventId, (int)Math.round(seconds * 20.0D));
+	}
+
+	/**
+	 * Starts a client-side tick timer for eventId for the given number of ticks (20 ticks = 1 sec).
+	 * Calls eventX(mc) every client tick until time expires.
+	 * Safe to call inside eventX(mc) itself (will not reset while already ticking).
+	 */
+	public static void startClientTimerTicks(int eventId, int ticks) {
+		if(eventId >= 0 && eventId < eventTimers.length && ticks > 0) {
+			if(inTimerTick[eventId]) {
+				return;
+			}
+			eventTimers[eventId] = ticks;
+			eventElapsedTicks[eventId] = 0;
+		}
+	}
+
+	public static void stopClientTimer(int eventId) {
+		if(eventId >= 0 && eventId < eventTimers.length) {
+			eventTimers[eventId] = 0;
+			eventElapsedTicks[eventId] = 0;
+		}
+	}
+
+	public static void stopAllClientTimers() {
+		for(int i = 0; i < eventTimers.length; ++i) {
+			eventTimers[i] = 0;
+			eventElapsedTicks[i] = 0;
+		}
+		synchronized(customTimedTasks) {
+			customTimedTasks.clear();
+		}
+	}
+
+	public static int getRemainingTicks(int eventId) {
+		if(eventId >= 0 && eventId < eventTimers.length) {
+			return eventTimers[eventId];
+		}
+		return 0;
+	}
+
+	/**
+	 * Runs a custom Runnable every client tick for the specified number of seconds.
+	 */
+	public static void runForSeconds(double seconds, Runnable task) {
+		runForTicks((int)Math.round(seconds * 20.0D), task);
+	}
+
+	/**
+	 * Runs a custom Runnable every client tick for the specified number of ticks (20 ticks = 1 sec).
+	 */
+	public static void runForTicks(int ticks, Runnable task) {
+		if(ticks > 0 && task != null) {
+			synchronized(customTimedTasks) {
+				customTimedTasks.add(new TimedTask(ticks, task));
+			}
+		}
+	}
+
+	/**
+	 * Runs a task repeatedly on a background thread for the specified duration.
+	 * Ideal for JNA window manipulation, mouse movement, or external GUI effects.
+	 *
+	 * @param seconds    Total duration in seconds
+	 * @param intervalMs Sleep interval in milliseconds between executions (e.g. 20L or 50L)
+	 * @param task       Runnable to execute repeatedly
+	 */
+	public static void runAsyncForSeconds(final double seconds, final long intervalMs, final Runnable task) {
+		if(seconds <= 0.0D || task == null) {
+			return;
+		}
+		Thread t = new Thread(new Runnable() {
+			public void run() {
+				long durationMs = Math.round(seconds * 1000.0D);
+				long endTime = System.currentTimeMillis() + durationMs;
+				while(System.currentTimeMillis() < endTime) {
+					try {
+						task.run();
+						if(intervalMs > 0L) {
+							Thread.sleep(intervalMs);
+						}
+					} catch (InterruptedException e) {
+						break;
+					} catch (Throwable t) {
+						t.printStackTrace();
+						break;
+					}
+				}
+			}
+		}, "DRE-ClientAsyncTimer");
+		t.setDaemon(true);
+		t.start();
+	}
