+		case 11: event11(mc); break;
+		case 12: event12(mc); break;
+		case 13: event13(mc); break;
+		case 14: event14(mc); break;
+		case 15: event15(mc); break;
+		case 16: event16(mc); break;
+		case 17: event17(mc); break;
+		case 18: event18(mc); break;
+		case 19: event19(mc); break;
+		case 20: event20(mc); break;
+		case 21: event21(mc); break;
+		case 22: event22(mc); break;
+		case 23: event23(mc); break;
+		case 24: event24(mc); break;
+		case 25: event25(mc); break;
+		case 26: event26(mc); break;
+		case 27: event27(mc); break;
+		case 28: event28(mc); break;
+		case 29: event29(mc); break;
+		case 30: event30(mc); break;
+		case 31: event31(mc); break;
+		case 32: event32(mc); break;
+		default:
+			onCustomClientEvent(mc, eventId, intArg, strArg);
+			break;
+		}
+	}
