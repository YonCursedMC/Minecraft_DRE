+	/**
+	 * Sends a packet from the server to start a client-side tick timer for the specified eventId.
+	 * On the client, tickEventX(mc) will be called every tick for the given number of ticks (20 ticks = 1 sec).
+	 */
+	public static void startTimerTicks(EntityPlayerMP player, int eventId, int ticks) {
+		sendInternal(player, MODE_TIMER_TICKS, eventId, ticks, "");
+	}
