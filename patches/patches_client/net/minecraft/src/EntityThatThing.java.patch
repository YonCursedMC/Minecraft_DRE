+package net.minecraft.src;
+
+public class EntityThatThing extends EntityMob {
+	public EntityThatThing(World world1) {
+		super(world1);
+		this.texture = "/addmob/That_Thing.png";
+		this.moveSpeed = 1.0F;
+		this.attackStrength = 1;
+		this.stepHeight = 20.0F;
+	}
+
+	public int getMaxHealth() {
+		return 20;
+	}
+
+	public void onLivingUpdate() {
+		super.onLivingUpdate();
+	}
+
+	protected void onAttackPlayerMP(EntityPlayerMP player) {
+		super.onAttackPlayerMP(player);
+		if(this.rand.nextInt(60) == 0) {
+			ClientEvents.event8(player);
+			this.setDead();
+		}
+	}
+
+	public void onUpdate() {
+		super.onUpdate();
+	}
+}
