+	// =====================================================================
+	// Config Persistence
+	// =====================================================================
+
+	public static void loadConfig() {
+		File f = new File("voicechat.properties");
+		if(!f.isFile()) {
+			return;
+		}
+		FileInputStream fis = null;
+		try {
+			Properties props = new Properties();
+			fis = new FileInputStream(f);
+			props.load(fis);
+			globalMode = Boolean.parseBoolean(props.getProperty("globalMode", "false"));
+			pushToTalk = Boolean.parseBoolean(props.getProperty("pushToTalk", "false"));
+			muted = Boolean.parseBoolean(props.getProperty("muted", "false"));
+			pttKey = Integer.parseInt(props.getProperty("pttKey", String.valueOf(Keyboard.KEY_C)));
+			maxProximityDistance = Float.parseFloat(props.getProperty("maxProximityDistance", "48.0"));
+			micGain = Float.parseFloat(props.getProperty("micGain", "1.0"));
+			speakerVolume = Float.parseFloat(props.getProperty("speakerVolume", "1.0"));
+			vadThreshold = Integer.parseInt(props.getProperty("vadThreshold", "450"));
+			selectedMicName = props.getProperty("selectedMicName", "");
+		} catch (Throwable ignored) {
+		} finally {
+			if(fis != null) {
+				try {
+					fis.close();
+				} catch (IOException ignored) {
+				}
+			}
+		}
+	}
+
+	public static void saveConfig() {
+		File f = new File("voicechat.properties");
+		FileOutputStream fos = null;
+		try {
+			Properties props = new Properties();
+			props.setProperty("globalMode", String.valueOf(globalMode));
+			props.setProperty("pushToTalk", String.valueOf(pushToTalk));
+			props.setProperty("muted", String.valueOf(muted));
+			props.setProperty("pttKey", String.valueOf(pttKey));
+			props.setProperty("maxProximityDistance", String.valueOf(maxProximityDistance));
+			props.setProperty("micGain", String.valueOf(micGain));
+			props.setProperty("speakerVolume", String.valueOf(speakerVolume));
+			props.setProperty("vadThreshold", String.valueOf(vadThreshold));
+			props.setProperty("selectedMicName", selectedMicName != null ? selectedMicName : "");
+			fos = new FileOutputStream(f);
+			props.store(fos, "DeathRouletteEdition Voice Chat Settings");
+		} catch (Throwable ignored) {
+		} finally {
+			if(fos != null) {
+				try {
+					fos.close();
+				} catch (IOException ignored) {
+				}
+			}
+		}
+	}
+}
