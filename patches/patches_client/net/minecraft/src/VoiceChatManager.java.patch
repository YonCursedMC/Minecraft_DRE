+	private static TargetDataLine openSelectedMicLine(AudioFormat format) {
+		DataLine.Info info = new DataLine.Info(TargetDataLine.class, format);
+		String wanted = selectedMicName;
+		if(wanted != null && wanted.length() > 0) {
+			try {
+				Mixer.Info[] mixers = AudioSystem.getMixerInfo();
+				if(mixers != null) {
+					for(int i = 0; i < mixers.length; ++i) {
+						if(wanted.equals(mixers[i].getName())) {
+							Mixer m = AudioSystem.getMixer(mixers[i]);
+							if(m.isLineSupported(info)) {
+								TargetDataLine line = (TargetDataLine)m.getLine(info);
+								line.open(format, FRAME_BYTES * 4);
+								line.start();
+								return line;
+							}
+						}
+					}
+				}
+			} catch (Throwable ignored) {
+			}
+		}
+		try {
+			if(AudioSystem.isLineSupported(info)) {
+				TargetDataLine line = (TargetDataLine)AudioSystem.getLine(info);
+				line.open(format, FRAME_BYTES * 4);
+				line.start();
+				return line;
+			}
+		} catch (Throwable ignored) {
+		}
+		return null;
+	}
