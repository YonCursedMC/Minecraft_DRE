+	public static synchronized void init() {
+		if(initialized) {
+			return;
+		}
+		initialized = true;
+		loadConfig();
+		running = true;
+		Thread captureThread = new Thread(new Runnable() {
+			public void run() {
+				captureLoop();
+			}
+		}, "DRE-VoiceCapture");
+		captureThread.setDaemon(true);
+		captureThread.start();
+	}
