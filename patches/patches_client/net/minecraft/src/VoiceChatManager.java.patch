+	public static boolean isPlayerSpeaking(String username) {
+		if(username == null) {
+			return false;
+		}
+		Minecraft mc = Minecraft.getMinecraft();
+		if(mc != null && mc.thePlayer != null && username.equals(mc.thePlayer.username)) {
+			return isLocalSpeaking();
+		}
+		RemoteSpeakerState state = (RemoteSpeakerState)remoteSpeakerStates.get(username);
+		return state != null && (System.currentTimeMillis() - state.lastPacketTime < 300L);
+	}
