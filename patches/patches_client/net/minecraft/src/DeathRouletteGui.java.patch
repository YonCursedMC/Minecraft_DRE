+	private void buildAllPlayerTracePaths() {
+		this.playerTracePaths.clear();
+		this.playerTraceLengths.clear();
+		this.playerDestCols.clear();
+
+		int leftX = 64;
+		int rightX = WINDOW_WIDTH - 64;
+		double colSpacing = (double)(rightX - leftX) / (double)(this.amidaCols - 1);
+		int topY = 166;
+		int bottomY = WINDOW_HEIGHT - 126;
+		double rowSpacing = (double)(bottomY - topY) / (double)(this.amidaRows + 1);
+
+		Iterator it = this.playerChoices.entrySet().iterator();
+		while(it.hasNext()) {
+			Map.Entry entry = (Map.Entry)it.next();
+			String user = (String)entry.getKey();
+			int startCol = ((Integer)entry.getValue()).intValue();
+
+			List points = new ArrayList();
+			int curCol = Math.max(0, Math.min(this.amidaCols - 1, startCol));
+			points.add(new double[]{leftX + curCol * colSpacing, topY});
+
+			for(int r = 0; r < this.amidaRows; ++r) {
+				double y = topY + (r + 1) * rowSpacing;
+				points.add(new double[]{leftX + curCol * colSpacing, y});
+				if(curCol < this.amidaCols - 1 && this.amidaBridges[r][curCol]) {
+					++curCol;
+					points.add(new double[]{leftX + curCol * colSpacing, y});
+				} else if(curCol > 0 && this.amidaBridges[r][curCol - 1]) {
+					--curCol;
+					points.add(new double[]{leftX + curCol * colSpacing, y});
+				}
+			}
+
+			points.add(new double[]{leftX + curCol * colSpacing, bottomY});
+			double totalLen = 0.0D;
+			for(int i = 0; i < points.size() - 1; ++i) {
+				double[] p1 = (double[])points.get(i);
+				double[] p2 = (double[])points.get(i + 1);
+				totalLen += Math.hypot(p2[0] - p1[0], p2[1] - p1[1]);
+			}
+
+			this.playerTracePaths.put(user, points);
+			this.playerTraceLengths.put(user, Double.valueOf(totalLen));
+			this.playerDestCols.put(user, Integer.valueOf(curCol));
+		}
+	}
