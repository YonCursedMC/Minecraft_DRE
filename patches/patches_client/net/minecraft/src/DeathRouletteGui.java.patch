+	public void actionPerformed(ActionEvent e) {
+		++this.bgFrame;
+
+		if(this.isRoulette || !this.amidaWaitingForPlayers) {
+			++this.animFrame;
+		}
+
+		if(this.isRoulette) {
+			if(this.animFrame <= PREPARE_FRAMES) {
+				this.currentAngleDeg = this.startAngleDeg;
+			} else if(this.animFrame <= PREPARE_FRAMES + ACTIVE_FRAMES) {
+				double t = (double)(this.animFrame - PREPARE_FRAMES) / (double)ACTIVE_FRAMES;
+				double ease = 1.0D - Math.pow(1.0D - t, 4.0D);
+				this.currentAngleDeg = this.startAngleDeg + (this.targetAngleDeg - this.startAngleDeg) * ease;
+			} else {
+				this.currentAngleDeg = this.targetAngleDeg;
+			}
+		}
+
+		this.repaint();
+
+		if((this.isRoulette || !this.amidaWaitingForPlayers) && this.animFrame >= TOTAL_ANIM_FRAMES) {
+			this.notifyFinishedOnce();
+		}
+	}
