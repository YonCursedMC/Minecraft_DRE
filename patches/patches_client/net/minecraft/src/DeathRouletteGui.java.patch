+	private void drawRoulette(Graphics2D g2) {
+		int cx = WINDOW_WIDTH / 2;
+		int cy = 345;
+		int radius = 215;
+		int count = this.escapeMode ? 5 : DeathRouletteEvents.EVENT_COUNT;
+		boolean isReveal = this.animFrame > (PREPARE_FRAMES + ACTIVE_FRAMES);
+
+		int pulse = (int)(Math.sin(this.bgFrame * 0.15D) * 25.0D + 55.0D);
+		g2.setColor(new Color(160, 10, 10, Math.max(20, Math.min(120, pulse))));
+		g2.fillOval(cx - radius - 18, cy - radius - 18, (radius + 18) * 2, (radius + 18) * 2);
+
+		g2.setColor(new Color(25, 6, 6));
+		g2.fillOval(cx - radius - 10, cy - radius - 10, (radius + 10) * 2, (radius + 10) * 2);
+
+		int visibleColorIdx = 0;
+		for(int i = 0; i < count; ++i) {
+			double sectorAngle = (this.rouletteSectorSpanDeg != null && i < this.rouletteSectorSpanDeg.length)
+					? this.rouletteSectorSpanDeg[i]
+					: (360.0D / (double)count);
+			if(sectorAngle <= 0.0001D) {
+				continue;
+			}
+			double sectorStartOffset = (this.rouletteSectorStartDeg != null && i < this.rouletteSectorStartDeg.length)
+					? this.rouletteSectorStartDeg[i]
+					: (i * sectorAngle);
+			double startDeg = this.currentAngleDeg + sectorStartOffset;
