+	private void initRoulette() {
+		int count = this.escapeMode ? 5 : DeathRouletteEvents.EVENT_COUNT;
+		this.rouletteSectorStartDeg = new double[count];
+		this.rouletteSectorSpanDeg = new double[count];
+
+		if(this.escapeMode) {
+			double equalAngle = 360.0D / (double)count;
+			for(int i = 0; i < count; ++i) {
+				this.rouletteSectorStartDeg[i] = i * equalAngle;
+				this.rouletteSectorSpanDeg[i] = equalAngle;
+			}
+		} else {
+			double totalWeight = 0.0D;
+			for(int i = 0; i < count; ++i) {
+				double w = (i < DeathRouletteEvents.ROULETTE_WEIGHTS.length) ? Math.max(0.0D, DeathRouletteEvents.ROULETTE_WEIGHTS[i]) : 0.0D;
+				totalWeight += w;
+			}
+			if(totalWeight <= 0.0D) {
+				double equalAngle = 360.0D / (double)count;
+				for(int i = 0; i < count; ++i) {
+					this.rouletteSectorStartDeg[i] = i * equalAngle;
+					this.rouletteSectorSpanDeg[i] = equalAngle;
+				}
+			} else {
+				double cumulativeDeg = 0.0D;
+				for(int i = 0; i < count; ++i) {
+					double w = (i < DeathRouletteEvents.ROULETTE_WEIGHTS.length) ? Math.max(0.0D, DeathRouletteEvents.ROULETTE_WEIGHTS[i]) : 0.0D;
+					double span = (w / totalWeight) * 360.0D;
+					this.rouletteSectorStartDeg[i] = cumulativeDeg;
+					this.rouletteSectorSpanDeg[i] = span;
+					cumulativeDeg += span;
+				}
+			}
+		}
+
+		int winIdx = Math.max(0, Math.min(count - 1, this.rouletteWinningEvent));
+		double sectorStart = this.rouletteSectorStartDeg[winIdx];
+		double sectorAngle = this.rouletteSectorSpanDeg[winIdx];
+		double winningCenterAngle = sectorStart + sectorAngle * 0.5D;
+		double jitter = (this.rand.nextDouble() - 0.5D) * (sectorAngle * 0.55D);
+		double desiredModAngle = 270.0D - (winningCenterAngle + jitter);
+		while(desiredModAngle < 0.0D) {
+			desiredModAngle += 360.0D;
+		}
+		desiredModAngle = desiredModAngle % 360.0D;
+
+		int extraSpins = 6 + this.rand.nextInt(3);
+		this.startAngleDeg = this.rand.nextDouble() * 360.0D;
+		double baseTarget = extraSpins * 360.0D + desiredModAngle;
+		while(baseTarget <= this.startAngleDeg + 360.0D * 5) {
+			baseTarget += 360.0D;
+		}
+		this.targetAngleDeg = baseTarget;
+		this.currentAngleDeg = this.startAngleDeg;
+	}
