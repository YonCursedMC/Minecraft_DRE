+	private int getTopBoxColAt(int mx, int my) {
+		int leftX = 64;
+		int rightX = WINDOW_WIDTH - 64;
+		double colSpacing = (double)(rightX - leftX) / (double)(this.amidaCols - 1);
+		int topY = 166;
+		int boxW = Math.min(52, (int)(colSpacing * 0.82D));
+		int boxH = 34;
+		int boxY = topY - boxH - 10;
+
+		for(int c = 0; c < this.amidaCols; ++c) {
+			int x = (int)Math.round(leftX + c * colSpacing);
+			Rectangle rect = new Rectangle(x - boxW / 2, boxY, boxW, boxH);
+			if(rect.contains(mx, my)) {
+				return c;
+			}
+		}
+		return -1;
+	}
