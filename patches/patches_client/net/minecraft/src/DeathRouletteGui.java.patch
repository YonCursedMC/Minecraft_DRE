+	private void drawPlayerTraces(Graphics2D g2, double progressRatio, boolean drawLocalPlayer) {
+		Iterator it = this.playerTracePaths.entrySet().iterator();
+		while(it.hasNext()) {
+			Map.Entry entry = (Map.Entry)it.next();
+			String user = (String)entry.getKey();
+			boolean isMe = this.localUsername.equals(user);
+			if(isMe != drawLocalPlayer) {
+				continue;
+			}
+
+			List points = (List)entry.getValue();
+			Double totalLenObj = (Double)this.playerTraceLengths.get(user);
+			if(points == null || points.isEmpty() || totalLenObj == null) {
+				continue;
+			}
+
+			double targetDist = totalLenObj.doubleValue() * progressRatio;
+			double drawnDist = 0.0D;
+			double tipX = ((double[])points.get(0))[0];
+			double tipY = ((double[])points.get(0))[1];
+
+			Path2D.Double tracePath = new Path2D.Double();
+			tracePath.moveTo(tipX, tipY);
+
+			for(int i = 0; i < points.size() - 1; ++i) {
+				double[] p1 = (double[])points.get(i);
+				double[] p2 = (double[])points.get(i + 1);
+				double segLen = Math.hypot(p2[0] - p1[0], p2[1] - p1[1]);
+				if(drawnDist + segLen <= targetDist) {
+					tracePath.lineTo(p2[0], p2[1]);
+					tipX = p2[0];
+					tipY = p2[1];
+					drawnDist += segLen;
+				} else {
+					double remain = targetDist - drawnDist;
+					double frac = segLen > 0.0D ? (remain / segLen) : 0.0D;
+					tipX = p1[0] + (p2[0] - p1[0]) * frac;
+					tipY = p1[1] + (p2[1] - p1[1]) * frac;
+					tracePath.lineTo(tipX, tipY);
+					break;
+				}
+			}
+
+			if(isMe) {
+				g2.setColor(new Color(220, 10, 10, 100));
+				g2.setStroke(new BasicStroke(9.0F, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
+				g2.draw(tracePath);
+
+				g2.setColor(new Color(255, 45, 45));
+				g2.setStroke(new BasicStroke(3.8F, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
+				g2.draw(tracePath);
+			} else {
+				g2.setColor(new Color(200, 95, 20, 80));
+				g2.setStroke(new BasicStroke(6.5F, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
+				g2.draw(tracePath);
+
+				g2.setColor(new Color(245, 145, 55));
+				g2.setStroke(new BasicStroke(2.6F, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
+				g2.draw(tracePath);
+			}
+
+			int tipR = isMe ? 7 : 5;
+			g2.setColor(isMe ? new Color(255, 210, 210) : new Color(255, 225, 160));
+			g2.fillOval((int)Math.round(tipX) - tipR, (int)Math.round(tipY) - tipR, tipR * 2, tipR * 2);
+		}
+	}
+
+	private String getPlayerWhoChoseCol(int col) {
+		Iterator it = this.playerChoices.entrySet().iterator();
+		while(it.hasNext()) {
+			Map.Entry entry = (Map.Entry)it.next();
+			if(((Integer)entry.getValue()).intValue() == col) {
+				return (String)entry.getKey();
+			}
+		}
+		return null;
+	}
