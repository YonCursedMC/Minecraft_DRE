+	private String fitTextToWidth(FontMetrics fm, String text, int maxWidth) {
+		if(text == null) {
+			return "";
+		}
+		if(fm.stringWidth(text) <= maxWidth) {
+			return text;
+		}
+		String ellipsis = "..";
+		int len = text.length();
+		while(len > 1 && fm.stringWidth(text.substring(0, len) + ellipsis) > maxWidth) {
+			--len;
+		}
+		return text.substring(0, Math.max(1, len)) + ellipsis;
+	}
