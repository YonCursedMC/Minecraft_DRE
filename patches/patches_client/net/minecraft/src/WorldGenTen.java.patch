+package net.minecraft.src;
+
+public class WorldGenTen {
+    public static void gene(EntityPlayerMP player) {
+        for (int i = 0; i <= 4; i++) {
+            player.worldObj.setBlockToAir((int)player.posX,(int)player.posY+i,(int)player.posZ, player.rand.nextInt(Block.none.blockID) + 1);
+        }
+        for (int i = -1; i <= 1; i++) {
+            if(i!=0){
+                player.worldObj.setBlockToAir((int)player.posX+i,(int)player.posY+3,(int)player.posZ, player.rand.nextInt(Block.none.blockID) + 1);
+            }
+        }
+    }
+}
